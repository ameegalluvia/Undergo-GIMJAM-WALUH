[sub_resource type="Resource" id="Resource_uexuo"]
script = ExtResource("1_ef17e")
nama = "Teman 3"
teks = "Alah! Kamu bisanya cuman cari alasan! Nggak pernah aku denger kamu ngaku salah. Selalu aja ‘nggak sengaja’. Selalu aja nyalahin orang lain"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_13x8c"]
