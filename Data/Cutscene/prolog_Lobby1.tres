[sub_resource type="Resource" id="Resource_kk1d7"]
script = ExtResource("1_usx58")
nama = "NPC 1"
teks = "Kayaknya aku belum pernah dengar film ini deh. [Censored], menurut kamu gimana? 
"
gambar = ExtResource("2_kk1d7")
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_vf638"]
script = ExtResource("1_usx58")
nama = "NPC 2"
teks = "Eh, kamu gila ya!? Banyak orang hilang gara gara film ini tau. Lagian, film ini tuh gak worth it banget buat ditonton. Cuman anak edgy yang suka film ini.”
*Johan mulai penasaran dan menguping, pura pura melihat-lihat poster di bioskop. Dia memberikan ‘side-eye’ kepada orang orang tersebut
"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_mb2s7"]
script = ExtResource("1_usx58")
nama = "NPC 1 "
teks = "Masa sih?"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_rghsj"]
script = ExtResource("1_usx58")
nama = "NPC 2"
teks = "Sumpah! Suer deh! Liat aja tuh ratingnya"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_mx5e0"]
script = ExtResource("1_usx58")
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_vnuy7"]
script = ExtResource("1_usx58")
nama = "NPC 1"
teks = "... Bener juga ya… Tapi aku nggak percaya soal banyak orang yang hilang gara gara nonton film ini. Jangan terlalu dimistis-mistiskan lah."
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_g7i5e"]
script = ExtResource("1_usx58")
nama = "NPC 2"
teks = "Padahal tadi banyak banget loh poster-poster orang hilang sebelum kita masuk bioskop"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_2bqkw"]
script = ExtResource("1_usx58")
nama = "NPC 1"
teks = "Ih, jangan buat takut napa!"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_xhbhh"]
script = ExtResource("1_usx58")
nama = "NPC 2"
teks = "Makanya, ayo kita keluar. Bioskop ini tuh cuman nayangin film-film gak bener”
*Kedua orang tersebut pergi meninggalkan bioskop. MC mencuri kesempatan ini untuk melihat-lihat poster film tersebut"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_ju6is"]
