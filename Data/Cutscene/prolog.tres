[sub_resource type="Resource" id="Resource_g0jcx"]
script = ExtResource("1_i74w4")
teks = "Jam 9 malam ??? terlelap ketika menonton sebuah film di sebuah bioskop di sebuah pinggiran kota. Dia terlelap karena “mental disorder”nya kambuh dan dia meminum obat penenang. Saat itu, hanya ada beberapa orang di dalam teater. Mereka menonton sebuah film horor dengan rating rendah. ?? mendengar rumor bahwa alasan dibalik kenapa film tersebut adalah karena film-nya sangat mengganggu (disturbing) dan ada rumor bahwa jika seseorang tertidur saat menonton film tersebut, ia akan dibawa ke suatu tempat dimana ada kemungkinan orang tersebut tidak akan kembali. Beberapa kasus orang hilang dikaitkan dengan film ini. Pengadilan dalam beberapa hari kedepan akan memutuskan apakah film tersebut akan ditarik peredarannya. "
gambar = ExtResource("2_3lbo8")
pakai_transisi = false
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

