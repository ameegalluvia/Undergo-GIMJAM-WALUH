[sub_resource type="Resource" id="Resource_uc441"]
script = ExtResource("1_ghh5u")
teks = "anak itu masuk ke kamar keluarga mereka, mencari kakaknya. Tidak sadar dengan percakapan berat antara ayah dan ibunya"
gambar = ExtResource("3_aogvu")
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_4krke"]
script = ExtResource("1_ghh5u")
nama = "Ayah"
teks = "Kenapa kita perlu liburan sih bu? sudah tau ekonomi saat ini lagi ga baik-baik  aja, ah semua ini gara-gara orang itu"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_ggmeb"]
script = ExtResource("1_ghh5u")
nama = "Ibu"
teks = "Yah, kita liburan tuh biar ayah bisa lebih rileks. Untuk keuangan pasti ada jalan keluarnya–"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_1xjhv"]
script = ExtResource("1_ghh5u")
nama = "Ayah"
teks = "Jalan keluarnya!? Ibu sadar kan yang ibu lakuin ini cuma buang-buang uang? Anak-anak masih bisa liburan walaupun di rumah!”"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_ayxle"]
script = ExtResource("1_ghh5u")
nama = "Ibu"
teks = "Kok ayah tiba-tiba marah sih? Ibu cuma mau bantu ayah…"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_us44c"]
script = ExtResource("1_ghh5u")
nama = "Ayah"
teks = "Bantu? yang ibu lakuin cuma diam di rumah dan ngabisin uang ayah!"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_1tho3"]
script = ExtResource("1_ghh5u")
nama = "Ibu"
teks = "Ayah sadar ga sih, uang ayah ga akan habis kalau ayah GA PAKE BUAT MINUM-MINUM DAN KETEMU PEREMPUAN-PEREMPUAN BAJI–"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_rf536"]
script = ExtResource("1_ghh5u")
nama = "Anak"
teks = "KAK! Keluar aja deh. Adek tau kakak ada disini…"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_43n5j"]
script = ExtResource("1_ghh5u")
nama = "Ibu"
teks = "Ya Tuhan… Celaka"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_u76vh"]
script = ExtResource("1_ghh5u")
teks = "Ayah melihat ke arah sang anak dan kembali menatap ibunya, lalu dengan cepat keluar kamar dengan kesalnya"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_wbgkm"]
script = ExtResource("1_ghh5u")
teks = "Ibunya berlari ke arah anak itu dan memeluknya sambil berbisik"
gambar = ExtResource("4_max75")
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_h1mvk"]
script = ExtResource("1_ghh5u")
nama = "Ibu"
teks = "Sayang, ibu mau kamu janji, kamu harus jadi anak yang baik. Kamu ga perlu jadi sempurna, cukup jadi baik…
"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

