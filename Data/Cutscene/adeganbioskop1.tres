[sub_resource type="Resource" id="Resource_dyjey"]
script = ExtResource("1_0yva6")
teks = "Johan sedang melihat-lihat list film yang ada di bioskop."
pakai_transisi = false
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_tsccx"]
script = ExtResource("1_0yva6")
nama = "NPC1"
teks = "Kayaknya aku belum pernah dengar film ini deh. [Censored], menurut kamu gimana?"
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_3g3um"]
script = ExtResource("1_0yva6")
nama = "NPC2"
teks = "Eh, kamu gila ya!? Banyak orang hilang gara-gara film ini tau. Lagian, film ini tuh gak worth it banget buat ditonton. Cuman anak edgy yang suka film ini."
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_7vgca"]
script = ExtResource("1_0yva6")
teks = "Johan mulai penasaran dan menguping, pura-pura melihat-lihat poster di bioskop. Dia memberikan 'side-eye' kepada orang-orang tersebut."
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_5qq74"]
script = ExtResource("1_0yva6")
nama = "NPC1"
