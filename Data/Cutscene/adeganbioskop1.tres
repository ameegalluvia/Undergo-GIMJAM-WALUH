[sub_resource type="Resource" id="Resource_rcacb"]
script = ExtResource("1_0yva6")
nama = "NPC1"
teks = "... Bener juga ya... Tapi aku nggak percaya soal banyak orang yang hilang gara-gara nonton film ini. Jangan terlalu dimistis-mistiskan lah."
metadata/_custom_type_script = "uid://co8fvnpi56sa1"

[sub_resource type="Resource" id="Resource_0whby"]
